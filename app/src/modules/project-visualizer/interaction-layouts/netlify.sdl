// Netlify CLI - interaction layout profile (Project Visualizer).
interactionLayout {
    id "netlify"
    name "Netlify CLI"
    stackRef "Node.js"
    profileVersion "0.1.0"
    parentTool "node"

    summary "Deploy static/JAMstack; netlify.toml."

    layout zone {
        id "project-root"
        title "Netlify site"
        order 1
        memoryBin "netlify.toml"
        anchorFiles "netlify.toml"
    }

    grammar {
        id "primary"
        shape "netlify {cmd}"
        scriptSource "netlify.toml build"
        notes "Local netlify dev proxies functions."
    }

    preset {
        id "dev"
        label "dev"
        command "pnpm exec netlify dev"
        cwd "project-root"
    }
    preset {
        id "deploy"
        label "deploy"
        command "pnpm exec netlify deploy"
        cwd "project-root"
    }
    extract {
        manifest "netlify.toml" fields "build"
    }
}
