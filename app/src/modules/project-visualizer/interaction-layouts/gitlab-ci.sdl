// GitLab CI - interaction layout profile (Project Visualizer).
interactionLayout {
    id "gitlab-ci"
    name "GitLab CI"
    stackRef "CI"
    profileVersion "0.1.0"

    summary "CI; .gitlab-ci.yml; stages/jobs."

    layout zone {
        id "ci"
        title "GitLab CI"
        order 1
        memoryBin ".gitlab-ci.yml; includes"
        anchorFiles ".gitlab-ci.yml"
    }

    grammar {
        id "primary"
        shape "glab ci lint"
        scriptSource ".gitlab-ci.yml"
        notes "Stages are the spine."
    }

    preset {
        id "validate"
        label "validate"
        command "glab ci lint"
        cwd "ci"
    }
    extract {
        manifest ".gitlab-ci.yml" fields "stages"
    }
}
