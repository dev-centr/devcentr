// GitHub Actions - interaction layout profile (Project Visualizer).
interactionLayout {
    id "github-actions"
    name "GitHub Actions"
    stackRef "CI"
    profileVersion "0.1.0"

    summary "CI workflows; .github/workflows."

    layout zone {
        id "workflows"
        title "Actions workflows"
        order 1
        memoryBin ".github/workflows"
        anchorFiles ".github/workflows"
    }

    grammar {
        id "primary"
        shape "gh workflow list (local)"
        scriptSource "workflow YAML"
        notes "Mental model is job graph, not a local cwd."
    }

    preset {
        id "list"
        label "list"
        command "gh workflow list"
        cwd "workflows"
    }
    extract {
        manifest ".github/workflows"
    }
}
