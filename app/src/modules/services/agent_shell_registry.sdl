        id "windsurf"
        displayName "Windsurf"
        category "ide-hosted"
        status "active"
        detectCommand "windsurf"
        aiClientProfile "windsurf"
        modelTopologies "cloud"
    }

    ide {
        id "google-antigravity"
        displayName "Google Antigravity"
        category "ide-hosted"
        status "active"
        detectCommand "antigravity"
        aiClientProfile "google-antigravity"
        modelTopologies "cloud"
    }

    ide {
        id "zed"
        displayName "Zed"
        category "ide-hosted"
        status "active"
        detectCommand "zed"
        aiClientProfile "zed"
        modelTopologies "cloud" "compatible-proxy"
        notes "Lighter native editor host than Electron IDEs."
    }

    // --- Inference hosts & interconnects (compute topology) ---

    inference {
        id "lm-studio"
        displayName "LM Studio"
        category "inference-host"
        status "active"
        homepage "https://lmstudio.ai/"
        localApiDefault "http://127.0.0.1:1234"
        modelTopologies "local"
        notes "Low-level model runner; pair with Bionic for agent UX or point CLIs at local OpenAI-compatible API."
    }

    inference {
        id "llmster"
        displayName "llmster (headless LM Studio)"
        category "inference-host"
        status "active"
        homepage "https://build.nvidia.com/spark/lm-studio"
        modelTopologies "local" "network-local"
        notes "Terminal-native LM Studio on servers / DGX Spark."
    }

    inference {
        id "ollama"
        displayName "Ollama"
        category "inference-host"
        status "active"
        homepage "https://ollama.com/"
        detectCommand "ollama"
        localApiDefault "http://127.0.0.1:11434"
        modelTopologies "local" "network-local"
        notes "Common DGX Spark / LAN pattern via OLLAMA_HOST=0.0.0.0 or SSH tunnel."
    }

    inference {
        id "vllm"
        displayName "vLLM"
        category "inference-host"
        status "active"
        homepage "https://github.com/vllm-project/vllm"
        modelTopologies "local" "network-local"
        notes "High-throughput OpenAI-compatible server on serious GPU boxes."
    }

    interconnect {
        id "lm-link"
        displayName "LM Link"
        category "interconnect"
        status "active"
        homepage "https://lmstudio.ai/link"
        modelTopologies "network-local"
        strengths "Tailscale/tsnet userspace mesh; remote models appear on localhost:1234; no public ports"
        notes "Primary path laptop ↔ DGX Spark / home GPU for LM Studio ecosystem and any localhost OpenAI client."
    }

    interconnect {
        id "ssh-tunnel"
        displayName "SSH local port forward"
        category "interconnect"
        status "active"
        modelTopologies "network-local"
        notes "ssh -N -L 11434:127.0.0.1:11434 user@compute — universal lowest-common-denominator."
    }

    interconnect {
        id "nvidia-sync"
        displayName "NVIDIA Sync"
        category "interconnect"
        status "active"
        homepage "https://docs.nvidia.com/dgx/dgx-spark/nvidia-sync.html"
        modelTopologies "network-local"
        notes "DGX Spark remote workflow companion; often paired with Ollama/vLLM/toolbox scripts."
    }

    interconnect {
        id "hermes-remote-gateway"
        displayName "Hermes remote gateway"
        category "interconnect"
        status "active"
        homepage "https://hermes-agent.nousresearch.com/docs/user-guide/features/web-dashboard"
        modelTopologies "network-local" "cloud"
        notes "Desktop/UI on thin client; hermes serve/dashboard on compute or VPS (prefer VPN/OAuth for non-LAN)."
    }

    // Performance posture cheat-sheet (qualitative; details in docs).
    posture {
        id "min-ram-laptop"
        title "Constrained laptop (≤16 GB), cloud models"
        arrangement "all-local"
        preferShells "agent-deck-tui" "opcode" "codexia" "t3-code"
        preferRuntimes "claude-code" "openai-codex" "opencode"
        avoid "full Electron IDE + Electron fleet + local 70B"
        rationale "Pay for frontier quality in the API; keep UI thin; do not also host weights."
    }

    posture {
        id "local-privacy"
        title "Local-first / air-gapped open models"
        arrangement "all-local"
        preferShells "lm-studio-bionic" "goose-desktop" "bodega-one-code"
        preferInference "lm-studio" "ollama"
        avoid "cloud-only shells without offline path"
        rationale "Shell overhead secondary to VRAM/quantization; Bionic makes compute location explicit."
    }

    posture {
        id "network-local-spark"
        title "Session local + owned inference (DGX Spark / GPU box)"
        arrangement "inference-remote-session-local"
        preferShells "lm-studio-bionic" "hermes-desktop" "aider-webui" "t3-code"
        preferInference "llmster" "ollama" "vllm"
        preferInterconnects "lm-link" "hermes-remote-gateway" "ssh-tunnel" "nvidia-sync"
        rationale "UI + tools + repo on the machine whose env the user understands; weights on Spark. Default network-local."
    }

    posture {
        id "remote-env-ops"
        title "Dedicated environment / ops machine"
        arrangement "remote-env"
        preferShells "t3-code" "hermes-desktop" "athena-workspace" "agent-deck-tui" "codexia"
        rationale "Theo / T3-style: run agent tool loops on a machine with a good FS/OS for ops (often Linux), UI on the daily driver."
    }

    posture {
        id "three-tier-travel"
        title "Travel UI + home env + owned GPU"
        arrangement "three-tier"
        preferShells "t3-code" "hermes-desktop" "lm-studio-bionic" "aider-webui" "codexia"
        preferInference "llmster" "ollama" "vllm"
        preferInterconnects "lm-link" "hermes-remote-gateway" "ssh-tunnel" "nvidia-sync"
        rationale "Laptop at a conference sends work to the env machine; env machine calls Spark for inference."
    }

    posture {
        id "sota-online"
        title "State-of-the-art hosted models"
        arrangement "all-local"
        preferShells "openai-codex-app" "t3-code" "hermes-desktop" "cursor"
        preferRuntimes "claude-code" "openai-codex" "cursor-cli"
        rationale "Shell choice is UX; model quality and latency dominate. Still pick env host deliberately if FS/ops hurt."
    }
}
