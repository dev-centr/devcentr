// Living registry of AI agent execution shells, runtimes, inference hosts, and interconnects.
// Product job: detect / shop / set up / launch — not reimplement agent control planes.
// Human companion: general-knowledge explanation/infrastructure/agent-control-planes.adoc
// Spec: specifications/components/agent-shell-registry.adoc
// Keep in sync with ai_client_profiles.json5 for MCP/skills clients (different concern).

registry {
    meta {
        id "agent-shells"
        title "Agent shells and control planes"
        version "0.2.0"
        lastReviewed "2026-07-27"
        purpose "Catalog standalone and related agent UIs so DevCentr can detect, recommend, configure, and hand off — without owning the Agent-Control Plane Layout. Named arrangements are layout recipes for the Role Topology Composer (ai-stack pack in ai_stack_domain_pack.sdl)."
        maintenance "Add new players here first; docs catalog is generated/curated from this file. Mark status archived when a project dies; do not delete history entries. New topology patterns get an arrangement (layoutRecipe) block + docs Mermaid, not only a shell entry."
    }

    // Structural categories (distinct product jobs).
    category {
        id "execution-shell"
        title "Standalone execution shell"
        summary "Desktop/web UI that wraps headless agent runtimes (CLI/app-server/daemon). Session rail + action trace + artifact/preview + approve gates."
    }
    category {
        id "fleet-orchestrator"
        title "Multi-agent fleet / deck"
        summary "Grid or TUI for many parallel agent PTYs/sessions across projects; often thinner protocol integration than a first-party shell."
    }
    category {
        id "agent-runtime"
        title "Agent runtime (CLI / TUI / daemon)"
        summary "The thing that actually plans/tools/edits. Shells wrap these; DevCentr configures env/MCP/rules for them."
    }
    category {
        id "ide-hosted"
        title "IDE-hosted agent"
        summary "Agent UI living inside an editor (extension or built-in). Heavier host process; strong for edit loops, weaker for multi-agent tiling."
    }
    category {
        id "inference-host"
        title "Inference host"
        summary "Serves local or owned-hardware models (OpenAI-compatible API). Not an agent shell; shells and runtimes point at these."
    }
    category {
        id "interconnect"
        title "Network-local interconnect"
        summary "Secure path from thin client machine to owned compute (DGX Spark, home GPU box) without public exposure."
    }
    category {
        id "workflow-arrangement"
        title "Workflow arrangement"
        summary "Named placement of UI vs environment/ops vs inference. Product surface: AI Workflow Arrangement (not a wizard)."
    }

    // --- Named arrangements (AI Workflow Arrangement cards) ---

    arrangement {
        id "all-local"
        title "All local"
        iconKey "arr-all-local"
        category "workflow-arrangement"
        uiHost "local"
        envHost "local"
        inferenceHost "local-or-cloud-api"
        fit "Everyday work; simplest mental model. UI, tools, and repo on one machine; inference local or vendor cloud."
        avoidWhen "Laptop FS or RAM cannot host agent tool loops; or you need owned GPU capacity."
        preferShells "t3-code" "opcode" "openai-codex-app" "cursor" "lm-studio-bionic"
        devcentrShell "local-repo-terminal"
        diagramRef "general-knowledge agent-control-planes arrangement A"
    }

    arrangement {
        id "inference-remote-session-local"
        title "Inference remote, session local"
        iconKey "arr-infer-remote"
        category "workflow-arrangement"
        uiHost "local"
        envHost "local"
        inferenceHost "network-local"
        fit "Default network-local: environment matches user awareness; DGX Spark / GPU box only serves weights (LM Link, tunnel, OpenAI-compatible API)."
        avoidWhen "You need the working tree and builds on a different OS/FS than the laptop."
        preferShells "lm-studio-bionic" "t3-code" "hermes-desktop" "aider-webui"
        preferInterconnects "lm-link" "ssh-tunnel" "nvidia-sync"
        preferInference "llmster" "ollama" "vllm" "lm-studio"
        supportsRemoteInference true
        devcentrShell "local-repo-terminal"
        diagramRef "general-knowledge agent-control-planes arrangement B"
    }

    arrangement {
        id "remote-env"
        title "Remote environment host"
        iconKey "arr-remote-env"
        category "workflow-arrangement"
        uiHost "local-or-thin"
        envHost "remote"
        inferenceHost "cloud-or-with-env"
        fit "Theo / T3-style: dedicated ops machine for tools + working tree (e.g. avoid macOS filesystem pain). UI on laptop; session runs on env host."
        avoidWhen "You only need bigger weights and the laptop FS is already fine — use inference-remote-session-local instead."
        preferShells "t3-code" "hermes-desktop" "athena-workspace" "agent-deck-tui" "aider-webui" "codexia"
        supportsRemoteEnv true
        supportsRemoteUi true
        devcentrShell "env-host-terminal"
        notes "DevCentr shell and env-refresh must attach to the env host (SSH/remote), not pretend laptop PATH is the agent PATH."
        diagramRef "general-knowledge agent-control-planes arrangement C"
    }

    arrangement {
        id "three-tier"
        title "Three-tier travel"
        iconKey "arr-three-tier"
        category "workflow-arrangement"
        uiHost "travel-laptop"
        envHost "remote"
        inferenceHost "network-local"
        fit "Conference/vacation laptop → home/office environment machine (ops + session) → DGX Spark inference. Supports agent managers with remote env + remote inference."
        avoidWhen "Collapsing env host and Spark onto one box if builds and VRAM fight; or when a single remote-env without owned GPU is enough."
        preferShells "t3-code" "hermes-desktop" "lm-studio-bionic" "aider-webui" "codexia"
        preferInterconnects "lm-link" "hermes-remote-gateway" "ssh-tunnel" "nvidia-sync"
        preferInference "llmster" "ollama" "vllm"
        supportsRemoteEnv true
        supportsRemoteInference true
        supportsRemoteUi true
        supportsTravelThreeTier true
        devcentrShell "env-host-terminal"
        diagramRef "general-knowledge agent-control-planes arrangement D"
    }

    arrangement {
        id "agent-gateway-remote"
        title "Agent gateway remote"
        iconKey "arr-agent-gateway"
        category "workflow-arrangement"
        uiHost "local"
        envHost "gateway-or-local"
        inferenceHost "depends"
        fit "Long-lived agent daemon/gateway on a server; laptop UI is remote control (e.g. Hermes serve)."
        avoidWhen "You only needed remote weights — prefer inference-remote-session-local."
        preferShells "hermes-desktop"
        preferInterconnects "hermes-remote-gateway"
        supportsRemoteUi true
        devcentrShell "clarify-tree-location"
        diagramRef "general-knowledge agent-control-planes arrangement E"
    }

    arrangement {
        id "workspace-remote"
        title "Whole workspace remote"
        iconKey "arr-workspace-remote"
        category "workflow-arrangement"
        uiHost "display-client"
        envHost "remote"
        inferenceHost "with-workspace-or-separate"
        fit "Editor/agent/repo live on remote machine (NVIDIA Sync, SSH desktop, cloud workspace); laptop is display/input."
        avoidWhen "You only want remote inference while keeping local edit awareness."
        preferInterconnects "nvidia-sync" "ssh-tunnel"
        devcentrShell "remote-first"
        diagramRef "general-knowledge agent-control-planes arrangement F"
    }

    // --- Execution shells (primary shopping list) ---

    shell {
        id "lm-studio-bionic"
        displayName "LM Studio Bionic"
        category "execution-shell"
        status "active"
        homepage "https://lmstudio.ai/docs/bionic"
        vendor "LM Studio"
        frameworks "native-desktop"
        platforms "windows" "macos" "linux"
        backends "bionic-agent"
        modelTopologies "local" "network-local" "vendor-open-cloud"
        interconnects "lm-link"
        detectHints "Bionic app install; LM Studio sibling still used for low-level model config"
        strengths "First-class local + LM Link + Secure Cloud switch; code + work projects; privacy-oriented open models"
        notes "Often misnamed 'LLM Bionic'. Separate app from classic LM Studio chat. Compute location is the control-plane choice."
        supportsRemoteInference true
    }

    shell {
        id "t3-code"
        displayName "T3 Code"
        category "execution-shell"
        status "active"
        homepage "https://github.com/pingdotgg/t3code"
        repo "https://github.com/pingdotgg/t3code"
        vendor "T3 Tools / pingdotgg"
        frameworks "electron" "web"
        platforms "windows" "macos" "linux"
        backends "openai-codex" "claude-code" "cursor-cli" "opencode"
        modelTopologies "depends-on-backend"
        detectCommand "t3code"
        installHints "winget T3Tools.T3Code; brew --cask t3-code"
        strengths "Minimal multi-provider GUI; remote access docs; decouples session from IDE buffers"
        notes "Wraps CLI auth of each provider; does not replace Codex/Claude/OpenCode installs. Strong fit for remote-env / three-tier when UI is thin and ops run on a dedicated machine (Theo-style)."
        supportsRemoteEnv true
        supportsRemoteUi true
        supportsTravelThreeTier true
    }

    shell {
        id "hermes-desktop"
        displayName "Hermes Desktop"
        category "execution-shell"
        status "active"
        homepage "https://hermes-agent.nousresearch.com/docs/user-guide/desktop"
        repo "https://github.com/NousResearch/hermes-agent"
        vendor "Nous Research"
        frameworks "electron"
        platforms "windows" "macos" "linux"
        backends "hermes-agent"
        modelTopologies "local" "cloud" "remote-gateway"
        detectCommand "hermes"
        launchHints "hermes desktop"
        strengths "Official GUI for Hermes; shared config/memory/skills with CLI; remote gateway to VPS/home server"
        notes "Drives headless hermes serve (tui_gateway). Web dashboard is a sibling surface, not required by Desktop."
        supportsRemoteEnv true
        supportsRemoteUi true
        supportsTravelThreeTier true
    }

    shell {
