            description "Streaming-friendly logs and datasets of JSON objects."
        }
    }

    classification {
        id "plaintext"
        label "Plain text"
        summary "Unstructured notes without a markup or data language."

        type {
            id "txt"
            label "Plain text"
            role "Unstructured notes"
            description "A plain .txt file with no markup or schema."
            extension ".txt"
            suggestedName "notes"
            inventedYear 1970
            lastUpdated "2026"
            vitality "mature"
            creatable true
        }
    }

    lineage {
        scope "docs"
        edge { from "markdown" to "mdx" kind "specializes" note "JSX in docs; React pipelines only." }
        edge { from "markdown" to "centrmark" kind "evolves" note "Directive AST without pulling JS into prose." }
        edge { from "markdown" to "djot" kind "evolves" note "Unambiguous lightweight markup from Pandoc’s author." }
        edge { from "asciidoc" to "centrmark" kind "evolves" note "Keep Antora publishing; migrate authoring over time." }
        edge { from "rst" to "markdown" kind "dialect" note "Sphinx vs forge-README worlds." }
        edge { from "markdown" to "typst" kind "specializes" note "Typeset papers; not a README replacement." }
    }

    lineage {
        scope "config"
        edge { from "json" to "json5" kind "evolves" note "Comments and trailing commas." }
        edge { from "json" to "sdlang" kind "evolves" note "Human-edited config with native types." }
        edge { from "sdlang" to "kdl" kind "supersedes" note "Modern successor grammar and /- comments; DevCentr keeps .sdl in-stack." }
        edge { from "sdlang" to "xdl" kind "specializes" note "Extended SDL attempt; avoid — unfinished, not org policy." }
        edge { from "json" to "toml" kind "evolves" note "Obvious key-value with typed literals." }
        edge { from "json" to "yaml" kind "evolves" note "Indentation-driven documents; many footguns." }
        edge { from "xml" to "json" kind "evolves" note "Lighter interchange for many APIs." }
        edge { from "ini" to "toml" kind "evolves" note "Richer types and nesting than classic INI." }
        edge { from "json" to "toon" kind "specializes" note "Token-dense LLM payloads." }
        edge { from "json" to "cbor" kind "specializes" note "Binary JSON data model." }
        edge { from "json" to "msgpack" kind "specializes" note "Compact binary maps and arrays." }
        edge { from "json" to "pkl" kind "specializes" note "Programmable OO config that can emit JSON." }
        edge { from "json" to "cue" kind "specializes" note "Constrained unification." }
        edge { from "json" to "capnp" kind "specializes" note "Zero-copy schemaed binary." }
        edge { from "json" to "flatbuffers" kind "specializes" note "Zero-copy with wide bindings." }
        edge { from "cue" to "dhall" kind "dialect" note "Sibling non-Turing-complete config languages." }
    }

    lineage {
        scope "schema"
        edge { from "json-schema" to "openapi" kind "specializes" note "HTTP APIs on a JSON Schema-shaped foundation." }
        edge { from "protobuf" to "avro" kind "dialect" note "Sibling IDL/binary schema ecosystems." }
    }

    lineage {
        scope "data"
        edge { from "csv" to "tsv" kind "dialect" note "Same tabular idea; different delimiter." }
        edge { from "csv" to "jsonl" kind "specializes" note "One JSON object per line for streams." }
    }
}
