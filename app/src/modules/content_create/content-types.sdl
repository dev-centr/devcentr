            id "d"
            label "D"
            role "D source module"
            extension ".d"
            suggestedName "app"
            inventedYear 2001
            lastUpdated "2026"
            homepage "https://dlang.org/"
            repo "https://github.com/dlang/dmd"
            vitality "mature"
            creatable true
            template """module app;

void main()
{
}
"""
            description "Stub .d module for D projects."
        }
