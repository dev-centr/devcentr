    classification {
        id "data"
        label "Tabular / data files"
        summary "Spreadsheets-as-text and simple datasets (not full databases)."

        type {
            id "csv"
            label "CSV"
            role "Comma-separated values"
            extension ".csv"
            suggestedName "data"
            inventedYear 1972
            lastUpdated "2005"
            spec "https://www.rfc-editor.org/rfc/rfc4180"
            vitality "mature"
            creatable true
            description "Interoperable tabular export; RFC 4180 is the common baseline."
        }
        type {
            id "tsv"
            label "TSV"
            role "Tab-separated values"
            extension ".tsv"
            suggestedName "data"
            inventedYear 1972
            lastUpdated "2020"
            vitality "mature"
            creatable true
            description "Prefer when fields contain commas."
        }
        type {
            id "jsonl"
            label "JSON Lines"
            role "Newline-delimited JSON records"
            extension ".jsonl"
            suggestedName "records"
            inventedYear 2013
            lastUpdated "2023"
            homepage "https://jsonlines.org/"
            spec "https://jsonlines.org/"
            vitality "mature"
