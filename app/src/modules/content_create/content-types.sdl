// Content Create catalog — classifications, types, and orthogonal lineage graphs.
// Parsed by modules.content_create.loader

contentTypes {
    version 1

    classification {
        id "docs"
        label "Documentation"
        summary "Prose for humans: guides, READMEs, Antora pages."

        type {
            id "centrmark"
            label "CentrMark"
            role "Dev-Centr prose markup with a stable directive AST"
            description """
            Prefer CentrMark for new Dev-Centr technical docs when a CentrMark toolchain is available.
            Void, block, and inline directives replace HTML hacks and MDX/JS injection while staying close to Markdown feel.
            Publishing may still target Antora via AsciiDoc backends during migration.
            """
            extension ".cmk"
            suggestedName "README"
            template """# Overview

Welcome.

:: toc
"""
            creatable true
        }

        type {
            id "asciidoc"
            label "AsciiDoc"
            role "Antora and published docs today"
            description """
            Use AsciiDoc when you need Antora component pages, xrefs, and the org’s existing docs pipeline.
            Strong for multi-repo documentation sites; syntax is heavier than Markdown for casual README work.
            """
            extension ".adoc"
            suggestedName "README"
            template """= Title
:description: Short summary.

Opening paragraph.
"""
            creatable true
        }

        type {
            id "markdown"
            label "Markdown"
            role "Interoperable plain prose"
            description """
            Use Markdown for maximum portability (GitHub README, forge defaults, tools that only speak CommonMark/GFM).
            Tabs, TOC, and admonitions usually need HTML or non-standard extensions—prefer CentrMark or AsciiDoc when those matter.
            """
            extension ".md"
            suggestedName "README"
            template """# Title

Opening paragraph.
"""
            creatable true
        }

        type {
            id "mdx"
            label "MDX"
            role "React docs pipelines only"
            description """
            Use MDX only when the docs site is a React/MDX pipeline and you intentionally embed JSX components.
            Do not choose MDX for general project prose—prefer CentrMark directives or AsciiDoc macros instead.
            """
            extension ".mdx"
            suggestedName "page"
            template """# Title

Opening paragraph.
"""
            creatable true
        }
    }

    classification {
        id "config"
        label "Configuration"
        summary "Structured data humans or tools edit: settings, manifests, schemas."

        type {
            id "json"
            label "JSON"
            role "Ubiquitous interchange (lineage anchor)"
            description """
            Plain JSON is the industry default for machine interchange. Prefer it when a tool requires strict JSON.
            For human-edited Dev-Centr-owned config, prefer SDLang; when stuck in the JSON family, prefer JSON5.
            """
            creatable false
        }

        type {
            id "sdlang"
            label "SDLang"
            role "Human-edited config when DevCentr owns the parser"
            description """
            Prefer .sdl for settings and catalogs DevCentr controls (advisor catalogs, recognizer profiles, .devcentr.sdl).
            Comments, native types, and low punctuation noise beat JSON/JSON5 for hand editing.
            KDL is a modern node-based successor narrative; stay on SDLang while sdlang-d and existing catalogs remain the stack.
            """
            extension ".sdl"
            suggestedName "config"
            template """// Project settings
settings {
    // key "value"
}
"""
            creatable true
        }

        type {
            id "kdl"
            label "KDL"
            role "Modern node-based document language"
            description """
            KDL improves on SDLang with a strict unambiguous grammar, /- node comments, and parenthetical type annotations.
            Choose KDL when the consuming toolchain has a solid KDL implementation and you are not bound to DevCentr’s SDLang parsers.
            For DevCentr-owned files, keep SDLang until the product migrates.
            """
            extension ".kdl"
            suggestedName "config"
            template """// Project settings
settings {
    // key "value"
}
"""
            creatable true
        }

        type {
            id "json5"
            label "JSON5"
            role "JSON family with comments when tools require JSON"
            description """
            Use JSON5 (or JSON) when a tool or API strictly requires the JSON model (package.json, editor settings, many CI configs).
            Prefer SDLang when you control the parser.
            """
            extension ".json5"
            suggestedName "config"
            template """{
  // key: "value"
}
"""
            creatable true
        }

        type {
            id "programmable"
            label "Programmable config"
            role "Schema, constraints, and generation in the config itself"

            type {
                id "pkl"
                label "Pkl"
                role "OO config with classes and codegen"
                description """
                Apple Pkl embeds classes, inheritance, and functions; compiles down to JSON/YAML for consumers.
                Pick when you need validated, programmable modules and multi-language codegen.
                """
                extension ".pkl"
                suggestedName "config"
                creatable true
            }

            type {
                id "cue"
                label "CUE"
                role "Types-as-values unification"
                description """
                CUE treats types as values with a non-Turing-complete lattice for deterministic validation.
                Pick when large configs must unify and constrain without becoming a full program.
                """
                extension ".cue"
                suggestedName "config"
                creatable true
            }

            type {
                id "nickel"
                label "Nickel"
                role "Functional config with contracts"
                description """
                Nickel uses gradual typing and contracts for structured configuration with runtime assertions.
                Pick when you want functional composition with enforceable contracts.
                """
                extension ".ncl"
                suggestedName "config"
                creatable true
            }

            type {
                id "kcl"
                label "KCL"
                role "Cloud-native constrained config"
                description """
                KCL (CNCF) focuses on immutability, schemas, and assertion-based constraints for infrastructure at scale.
                Pick for large cloud-native configuration surfaces.
                """
                extension ".k"
                suggestedName "config"
                creatable true
            }
        }

        type {
            id "ergonomic-serialization"
            label "Ergonomic / LLM serialization"
            role "Human or token-optimized text encodings of structured data"

            type {
                id "toon"
                label "TOON"
                role "Token-oriented object notation for LLM payloads"
                description """
                TOON reduces braces and repeated keys with tabular schema headers for LLM context windows.
                Pick when the primary consumer is an LLM pipeline and token density matters more than universal tooling.
                """
                extension ".toon"
                suggestedName "payload"
                creatable true
            }
        }

        type {
            id "binary-wire"
            label "Binary / zero-copy"
            role "Machine-first encodings when humans do not edit the file"

            type {
                id "capnp"
                label "Cap'n Proto"
                role "Zero-copy schemaed messages"
                description """
                Cap'n Proto lays out data like in-memory structures—no parse step to traverse.
                Pick for high-throughput RPC or storage where schemas are owned by your stack.
                """
                extension ".capnp"
                suggestedName "schema"
                creatable true
            }

            type {
                id "flatbuffers"
                label "FlatBuffers"
                role "Zero-copy with wide language bindings"
                description """
                FlatBuffers similarly avoids deserialization copies; strong mobile and game ecosystems.
                Pick when you need zero-copy with established FlatBuffers toolchains.
                """
                extension ".fbs"
                suggestedName "schema"
                creatable true
            }

            type {
                id "cbor"
                label "CBOR"
                role "Binary JSON data model"
                description """
                CBOR is a concise binary encoding of the JSON data model (RFC 8949).
                Pick for compact interchange that still maps cleanly to JSON semantics.
                """
                extension ".cbor"
                suggestedName "data"
                creatable false
            }

            type {
                id "msgpack"
                label "MessagePack"
                role "Compact binary maps and arrays"
                description """
                MessagePack encodes dynamic maps/arrays with typed byte prefixes.
                Pick as a drop-in binary companion to JSON-like payloads.
                """
                extension ".msgpack"
                suggestedName "data"
                creatable false
            }
        }
    }

    classification {
        id "code"
        label "Code"
        summary "Source files for a language toolchain."

        type {
            id "d"
            label "D"
            role "D source module"
            description "Stub .d module for D projects."
            extension ".d"
            suggestedName "app"
            template """module app;

void main()
{
}
"""
            creatable true
        }

        type {
            id "typescript"
            label "TypeScript"
            role "TypeScript source"
            description "Stub .ts file for TypeScript/Node projects."
            extension ".ts"
            suggestedName "index"
            template """export {};
"""
            creatable true
        }

        type {
            id "python"
            label "Python"
            role "Python source"
            description "Stub .py file for Python projects."
            extension ".py"
            suggestedName "main"
            template """def main() -> None:
    pass


if __name__ == "__main__":
    main()
"""
            creatable true
        }
    }

    classification {
        id "plaintext"
        label "Plain text"
        summary "Unstructured notes without a markup or data language."

        type {
            id "txt"
            label "Plain text"
            role "Unstructured notes"
            description "A plain .txt file with no markup or schema."
            extension ".txt"
            suggestedName "notes"
            creatable true
        }
    }

    lineage {
        scope "config"
        edge {
            from "json"
            to "json5"
            kind "evolves"
            note "Comments and trailing commas without leaving the JSON model."
        }
        edge {
            from "json"
            to "sdlang"
            kind "evolves"
            note "Human-edited config: comments, native types, less punctuation."
        }
        edge {
            from "sdlang"
            to "kdl"
            kind "supersedes"
            note "Modern successor: unambiguous grammar, /- node comments, type annotations."
        }
        edge {
            from "json"
            to "toon"
            kind "specializes"
            note "Token-dense tabular form for LLM payloads."
        }
        edge {
            from "json"
            to "cbor"
            kind "specializes"
            note "Binary JSON data model."
        }
        edge {
            from "json"
            to "msgpack"
            kind "specializes"
            note "Compact binary maps and arrays."
        }
        edge {
            from "json"
            to "pkl"
            kind "specializes"
            note "Programmable OO config that can emit JSON."
        }
        edge {
            from "json"
            to "cue"
            kind "specializes"
            note "Constrained unification over JSON-like data."
        }
        edge {
            from "json"
            to "capnp"
            kind "specializes"
            note "Zero-copy schemaed binary instead of text JSON."
        }
        edge {
            from "json"
            to "flatbuffers"
            kind "specializes"
            note "Zero-copy schemas with wide language bindings."
        }
    }

    lineage {
        scope "docs"
        edge {
            from "markdown"
            to "mdx"
            kind "specializes"
            note "JSX in docs; React pipelines only."
        }
        edge {
            from "markdown"
            to "centrmark"
            kind "evolves"
            note "Directive AST without pulling JS into prose."
        }
        edge {
            from "asciidoc"
            to "centrmark"
            kind "evolves"
            note "Keep Antora publishing; migrate authoring over time."
        }
    }
}
