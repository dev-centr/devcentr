// Content Create catalog — classifications, types, metadata, lineage.
// Parsed by modules.content_create.loader
// vitality: current | mature | legacy | outdated | reference

contentTypes {
    version 2

    classification {
        id "docs"
        label "Documentation"
        summary "Prose for humans: guides, READMEs, Antora pages, literate notes."

        type {
            id "centrmark"
            label "CentrMark"
            role "Dev-Centr prose markup with a stable directive AST"
            description """
            Prefer CentrMark for new Dev-Centr technical docs when a CentrMark toolchain is available.
            Void, block, and inline directives replace HTML hacks and MDX/JS injection.
            """
            extension ".cmk"
            suggestedName "README"
            template """# Overview

Welcome.

:: toc
"""
            inventedYear 2025
            lastUpdated "2026"
            homepage "https://github.com/dev-centr/centrmark"
            repo "https://github.com/dev-centr/centrmark"
            vitality "current"
            creatable true
        }

        type {
            id "asciidoc"
            label "AsciiDoc"
            role "Antora and published docs today"
            description """
            Use AsciiDoc when you need Antora component pages, xrefs, and the org’s existing docs pipeline.
            Official language definition today is the Asciidoctor-hosted AsciiDoc Language Documentation
            (https://docs.asciidoctor.org/asciidoc/latest/) — there is no ratified Eclipse Language Spec yet;
            the Eclipse AsciiDoc Language project (gitlab.eclipse.org/eclipse/asciidoc-lang/asciidoc-lang)
            is drafting a formal specification from that contribution. Until ratification, Asciidoctor defines the language.
            """
            extension ".adoc"
            suggestedName "README"
            template """= Title
:description: Short summary.

Opening paragraph.
"""
            inventedYear 2002
            lastUpdated "2026"
            homepage "https://asciidoc.org/"
            repo "https://gitlab.eclipse.org/eclipse/asciidoc-lang/asciidoc-lang"
            spec "https://docs.asciidoctor.org/asciidoc/latest/"
            vitality "mature"
            creatable true
        }

        type {
            id "markdown"
            label "Markdown"
            role "Interoperable plain prose"
            description """
            Maximum forge interop (GitHub README, CommonMark/GFM). Weak standardized story for tabs/TOC/admonitions.
            """
            extension ".md"
            suggestedName "README"
            template """# Title

Opening paragraph.
"""
            inventedYear 2004
            lastUpdated "2019"
            homepage "https://commonmark.org/"
            repo "https://github.com/commonmark/commonmark-spec"
            spec "https://spec.commonmark.org/"
            vitality "mature"
            creatable true
        }

        type {
            id "mdx"
            label "MDX"
            role "React docs pipelines only"
            description """
            Use only when the docs site is a React/MDX pipeline and you intentionally embed JSX.
            """
            extension ".mdx"
            suggestedName "page"
            inventedYear 2018
            lastUpdated "2025"
            homepage "https://mdxjs.com/"
            repo "https://github.com/mdx-js/mdx"
            spec "https://mdxjs.com/"
            vitality "legacy"
            creatable true
        }

        type {
            id "djot"
            label "Djot"
            role "Principled lightweight markup (Pandoc lineage)"
            description """
            John MacFarlane’s Djot aims for an unambiguous lightweight markup with a clear AST—useful when Markdown ambiguity hurts.
            """
            extension ".dj"
            suggestedName "README"
            inventedYear 2022
            lastUpdated "2025"
            homepage "https://djot.net/"
            repo "https://github.com/jgm/djot"
            spec "https://htmlpreview.github.io/?https://github.com/jgm/djot/blob/master/doc/syntax.html"
            vitality "current"
            creatable true
        }

        type {
            id "rst"
            label "reStructuredText"
            role "Sphinx / Python docs ecosystem"
            description """
            Prefer when the project already publishes with Sphinx. Heavier than Markdown; strong cross-refs in Python land.
            """
            extension ".rst"
            suggestedName "README"
            inventedYear 2002
            lastUpdated "2024"
            homepage "https://docutils.sourceforge.io/rst.html"
            repo "https://sourceforge.net/p/docutils/code/"
            spec "https://docutils.sourceforge.io/docs/ref/rst/restructuredtext.html"
            vitality "mature"
            creatable true
        }

        type {
            id "orgmode"
            label "Org Mode"
            role "Emacs literate notes and agendas"
            description """
            Prefer inside Emacs/Org workflows. Not a general forge README default.
            """
            extension ".org"
            suggestedName "notes"
            inventedYear 2003
            lastUpdated "2024"
            homepage "https://orgmode.org/"
            repo "https://git.savannah.gnu.org/cgit/emacs/org-mode.git"
            spec "https://orgmode.org/worg/dev/org-syntax.html"
            vitality "mature"
            creatable true
        }

        type {
            id "typst"
            label "Typst"
            role "Modern typesetting for papers and polished docs"
            description """
            LaTeX-like output with a friendlier scripting story. Prefer for papers/handouts; not a GitHub README default.
            """
            extension ".typ"
            suggestedName "doc"
            inventedYear 2023
            lastUpdated "2026"
            homepage "https://typst.app/"
            repo "https://github.com/typst/typst"
            spec "https://typst.app/docs/"
            vitality "current"
            creatable true
        }
    }

    classification {
        id "config"
        label "Configuration"
        summary "Structured data humans or tools edit: settings, manifests, env-shaped files."

        type {
            id "json"
            label "JSON"
            role "Ubiquitous interchange (lineage anchor)"
            description "Plain JSON when a tool requires strict JSON. Prefer SDLang for DevCentr-owned human config; JSON5 when stuck in the JSON family."
            inventedYear 2001
            lastUpdated "2017"
            homepage "https://www.json.org/"
            spec "https://www.rfc-editor.org/rfc/rfc8259"
            repo "https://github.com/json-schema-org"
            vitality "reference"
            creatable false
        }

        type {
            id "sdlang"
            label "SDLang"
            role "DevCentr-owned human config (default in-stack)"
            description """
            Prefer .sdl for catalogs and settings DevCentr parses with sdlang-d. Do not migrate those files to KDL or XDL without a deliberate stack change. KDL is for greenfield outside this parser surface.
            """
            extension ".sdl"
            suggestedName "config"
            template """// Project settings
settings {
    // key "value"
}
"""
            inventedYear 2005
            lastUpdated "2017"
            homepage "https://sdlang.org/"
            repo "https://github.com/dlang-community/SDLang-D"
            spec "https://github.com/dlang-community/SDLang-D/wiki/Language-Guide"
            vitality "mature"
            creatable true
        }

        type {
            id "kdl"
            label "KDL"
            role "Greenfield / cross-language node documents"
            description """
            Modern successor to SDLang: strict grammar, /- comments, (type) annotations. Prefer for new configs not loaded by DevCentr’s sdlang-d stack. D: dlang-supplemental/kdl-d (DUB package kdl). Not a drop-in replace for existing .sdl catalogs.
            """
            extension ".kdl"
            suggestedName "config"
            template """// Project settings
settings {
    // key "value"
}
"""
            inventedYear 2021
            lastUpdated "2024-12"
            homepage "https://kdl.dev/"
            repo "https://github.com/kdl-org/kdl"
            spec "https://kdl.dev/spec/"
            vitality "current"
            creatable true
        }

        type {
            id "xdl"
            label "Extended SDL (XDL)"
            role "Unfinished SDLang extension — do not adopt"
            description """
            XDL in newsdlang is not a Dev-Centr path: specs unfinished, implementation immature, KDL compatibility dropped. Prefer classic SDLang in-stack or KDL out-of-stack.
            """
            extension ".xdl"
            suggestedName "config"
            inventedYear 2024
            lastUpdated "2026-06"
            homepage "https://code.dlang.org/packages/newsdlang"
            repo "https://github.com/ZILtoid1991/newsdlang"
            vitality "legacy"
            creatable false
        }

        type {
            id "json5"
            label "JSON5"
            role "JSON family with comments"
            description "Use when tools require JSON-shaped files but humans edit them."
            extension ".json5"
            suggestedName "config"
            inventedYear 2012
            lastUpdated "2024"
            homepage "https://json5.org/"
            repo "https://github.com/json5/json5"
            spec "https://spec.json5.org/"
            vitality "mature"
            creatable true
        }

        type {
            id "toml"
            label "TOML"
            role "Obvious key-value config (Cargo, many CLIs)"
            description "Good for flat-to-moderate nesting. Prefer over YAML when you want less surprising parsing."
            extension ".toml"
            suggestedName "config"
            inventedYear 2013
            lastUpdated "2023"
            homepage "https://toml.io/"
            repo "https://github.com/toml-lang/toml"
            spec "https://toml.io/en/v1.0.0"
            vitality "mature"
            creatable true
        }

        type {
            id "yaml"
            label "YAML"
            role "CI and Kubernetes-shaped documents"
            description "Ubiquitous in CI/CD and k8s. Footguns abound—prefer TOML/SDLang/KDL for app settings you control."
            extension ".yaml"
            suggestedName "config"
            inventedYear 2001
            lastUpdated "2021"
            homepage "https://yaml.org/"
            repo "https://github.com/yaml/yaml-spec"
            spec "https://yaml.org/spec/1.2.2/"
            vitality "legacy"
            creatable true
        }

        type {
            id "xml"
            label "XML"
            role "Enterprise / legacy structured markup"
            description "Still required by many enterprise and build tools. Prefer JSON/KDL for new human-edited config."
            extension ".xml"
            suggestedName "config"
            inventedYear 1998
            lastUpdated "2008"
            homepage "https://www.w3.org/XML/"
            spec "https://www.w3.org/TR/xml/"
            vitality "legacy"
            creatable true
        }

        type {
            id "ini"
            label "INI"
            role "Minimal sectioned key-value files"
            description "Simple and portable; limited nesting. Fine for tiny tool configs."
            extension ".ini"
            suggestedName "config"
            inventedYear 1985
            lastUpdated "2020"
            vitality "legacy"
            creatable true
        }

        type {
            id "dotenv"
            label "Dotenv"
            role "Process environment key=value files"
            description "Local secrets and env overrides. Do not commit secrets; pair with DevCentr Secrets Manager."
            extension ".env"
            suggestedName "local"
            inventedYear 2012
            lastUpdated "2024"
            homepage "https://github.com/motdotla/dotenv"
            repo "https://github.com/motdotla/dotenv"
            vitality "mature"
            creatable true
        }

        type {
            id "programmable"
            label "Programmable config"
            role "Schema, constraints, and generation in the config itself"

            type {
                id "pkl"
                label "Pkl"
                role "OO config with classes and codegen"
                extension ".pkl"
                suggestedName "config"
                inventedYear 2024
                lastUpdated "2026"
                homepage "https://pkl-lang.org/"
                repo "https://github.com/apple/pkl"
                spec "https://pkl-lang.org/main/current/language-reference/index.html"
                vitality "current"
                creatable true
                description "Apple Pkl embeds classes and functions; often emits JSON/YAML for consumers."
            }
            type {
                id "cue"
                label "CUE"
                role "Types-as-values unification"
                extension ".cue"
                suggestedName "config"
                inventedYear 2018
                lastUpdated "2025"
                homepage "https://cuelang.org/"
                repo "https://github.com/cue-lang/cue"
                spec "https://cuelang.org/docs/"
                vitality "current"
                creatable true
                description "Non-Turing-complete constrained config; strong for large unified data."
            }
            type {
                id "nickel"
                label "Nickel"
                role "Functional config with contracts"
                extension ".ncl"
                suggestedName "config"
                inventedYear 2021
                lastUpdated "2025"
                homepage "https://nickel-lang.org/"
                repo "https://github.com/tweag/nickel"
                vitality "current"
                creatable true
                description "Gradual typing and contracts for structured configuration."
            }
            type {
                id "kcl"
                label "KCL"
                role "Cloud-native constrained config"
                extension ".k"
                suggestedName "config"
                inventedYear 2022
                lastUpdated "2025"
                homepage "https://kcl-lang.io/"
                repo "https://github.com/kcl-lang/kcl"
                vitality "current"
                creatable true
                description "CNCF-oriented schemas and assertions for infrastructure at scale."
            }
            type {
                id "dhall"
                label "Dhall"
                role "Non-Turing-complete programmable config"
                extension ".dhall"
                suggestedName "config"
                inventedYear 2016
                lastUpdated "2024"
                homepage "https://dhall-lang.org/"
                repo "https://github.com/dhall-lang/dhall-lang"
                spec "https://docs.dhall-lang.org/"
                vitality "mature"
                creatable true
                description "Importable, typed configuration that cannot loop forever."
            }
        }

        type {
            id "ergonomic-serialization"
            label "Ergonomic / LLM serialization"
            role "Human or token-optimized text encodings"

            type {
                id "toon"
                label "TOON"
                role "Token-oriented object notation for LLM payloads"
                extension ".toon"
                suggestedName "payload"
                inventedYear 2025
                lastUpdated "2026"
                vitality "current"
                creatable true
                description "Tabular/token-dense encoding for LLM context windows."
            }
        }

        type {
            id "binary-wire"
            label "Binary / zero-copy"
            role "Machine-first encodings"

            type {
                id "capnp"
                label "Cap'n Proto"
                role "Zero-copy schemaed messages"
                extension ".capnp"
                suggestedName "schema"
                inventedYear 2013
                lastUpdated "2025"
                homepage "https://capnproto.org/"
                repo "https://github.com/capnproto/capnproto"
                spec "https://capnproto.org/encoding.html"
                vitality "mature"
                creatable true
                description "Schema language + zero-copy runtime layout."
            }
            type {
                id "flatbuffers"
                label "FlatBuffers"
                role "Zero-copy with wide language bindings"
                extension ".fbs"
                suggestedName "schema"
                inventedYear 2014
                lastUpdated "2025"
                homepage "https://flatbuffers.dev/"
                repo "https://github.com/google/flatbuffers"
                spec "https://flatbuffers.dev/flatbuffers_guide_writing_schema.html"
                vitality "mature"
                creatable true
                description "Zero-copy serialization popular in games and mobile."
            }
            type {
                id "cbor"
                label "CBOR"
                role "Binary JSON data model"
                inventedYear 2013
                lastUpdated "2020"
                homepage "https://cbor.io/"
                spec "https://www.rfc-editor.org/rfc/rfc8949"
                vitality "reference"
                creatable false
                description "Concise Binary Object Representation (RFC 8949)."
            }
            type {
                id "msgpack"
                label "MessagePack"
                role "Compact binary maps and arrays"
                inventedYear 2008
                lastUpdated "2023"
                homepage "https://msgpack.org/"
                repo "https://github.com/msgpack/msgpack"
                spec "https://github.com/msgpack/msgpack/blob/master/spec.md"
                vitality "reference"
                creatable false
                description "Binary companion to JSON-like payloads."
            }
        }
    }

